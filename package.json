{
  "name": "english-pattern-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:deps": "node tools/check-deps.mjs",
    "web": "tsx apps/server/server.ts",
    "ui:build": "npm --prefix apps/ui run build",
    "ui:dev": "npm --prefix apps/ui run dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "tsx": "4.19.2"
  }
}
